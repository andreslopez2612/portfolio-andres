      <rect x="8" y="8" width="84" height="84" rx="10" stroke="#3178C6" stroke-width="5" fill="none"/>
      <path d="M28 40 H50 M39 40 V72" stroke="#3178C6" stroke-width="5" stroke-linecap="round"/>
      <path d="M58 65 C58 72 65 74 71 74 C78 74 82 70 82 65 C82 58 76 56 70 54 C64 52 59 50 59 44 C59 39 63 35 70 35 C76 35 80 38 81 43"
        stroke="#3178C6" stroke-width="5" fill="none" stroke-linecap="round"/>
    </svg>`,
  },
};

const project = {
  num: "01",
  title: "Formula 1 App",
  tag: "Full Stack · REST API + React",
  description:
    "REST API to manage Formula 1 data — drivers, teams, circuits, contracts, races and scoring — plus a React frontend that consumes it. Built solo following a real team workflow: sprints, tickets and documented architecture decisions.",
  techs: ["java", "spring", "mysql", "docker", "jwt", "react", "vite", "typescript"],
  links: [
    {
      label: "Live demo",
      url: "https://formula-1-app-beryl.vercel.app",
      primary: true,
    },
    {
      label: "API & Swagger docs",
      url: "https://formula-1-app-qnqp.onrender.com/swagger-ui/index.html",
      primary: false,
    },
    {
      label: "Source code",
      url: "https://github.com/andreslopez2612/formula_1_app",
      primary: false,
    },
  ],
  deployNote: "Deployed on Vercel (frontend) + Render (API) + Aiven (MySQL) — all free tier.",
  demoUser: { username: "viewer", password: "viewer123" },
};
---

<section id="works" class="section-padding overflow-hidden">
  <div class="container-section">
    <div class="works-header text-center mb-16">
      <p class="text-[var(--color-brand)] text-sm font-semibold uppercase tracking-widest mb-3">
        Projects
      </p>
      <h2 class="text-4xl sm:text-5xl font-black text-[var(--text)] leading-tight">
        What I <span class="text-gradient">build</span>
      </h2>
    </div>

    <article
      class="
        work-card
        group relative p-8 sm:p-10 rounded-2xl
        bg-[var(--surface)] border border-[var(--border)]
        hover:border-[var(--color-brand)]
        transition-all duration-300
        overflow-hidden
      "
    >
      <!-- Decorative hover background -->
      <div
        class="
          pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100
          transition-opacity duration-300
          bg-[radial-gradient(circle_at_top_right,oklch(55%_0.22_25_/_0.08),transparent_60%)]
        "
      ></div>

      <span class="text-5xl font-black text-[var(--border)] block mb-4 transition-colors group-hover:text-[var(--color-brand)]">
        {project.num}
      </span>

      <span
        class="inline-block px-3 py-1 rounded-full text-xs font-semibold mb-4"
        style="background-color: oklch(55% 0.22 25 / 0.12); color: var(--color-brand);"
      >
        {project.tag}
      </span>

      <h3 class="text-2xl sm:text-3xl font-bold text-[var(--text)] mb-3">
        {project.title}
      </h3>

      <p class="text-[var(--text-muted)] leading-relaxed max-w-2xl mb-6">
        {project.description}
      </p>

      <!-- Tech stack -->
      <div class="flex flex-wrap gap-3 mb-6">
        {project.techs.map((key) => {
          const icon = techIcons[key];
          return (
            <span
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium
                bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text)]"
              title={icon.name}
            >
              <Fragment set:html={icon.svg} />
              {icon.name}
            </span>
          );
        })}
      </div>

      <!-- Deploy links -->
      <div class="flex flex-wrap gap-3 mb-4">
        {project.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class={
              link.primary
                ? "inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold bg-[var(--color-brand)] text-white hover:bg-[var(--color-brand-light)] transition-colors duration-200"
                : "inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold border border-[var(--border)] text-[var(--text)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition-colors duration-200"
            }
          >
            {link.label}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
            </svg>
          </a>
        ))}
      </div>

      <p class="text-[var(--text-muted)] text-xs mb-6">{project.deployNote}</p>

      <!-- How to try it -->
      <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-2)] p-5">
        <p class="text-sm font-semibold text-[var(--text)] mb-2 flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          How to try it
        </p>
        <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-3">
          Log in with a <strong class="text-[var(--text)]">read-only</strong> demo account —
          you can browse drivers, teams, races and results, but create/edit/delete actions
          are disabled for this user.
        </p>
        <div class="flex flex-wrap gap-3 font-mono text-sm">
          <span class="px-3 py-1.5 rounded-lg bg-[var(--surface)] border border-[var(--border)] text-[var(--text)]">
            user: <strong>viewer</strong>
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-[var(--surface)] border border-[var(--border)] text-[var(--text)]">
            password: <strong>viewer123</strong>
          </span>
        </div>
        <p class="text-[var(--text-muted)] text-xs mt-3">
          ⚠️ The API runs on Render's free tier — if it's been idle for ~15 minutes, the
          first request can take 30-50s to respond while it spins back up.
        </p>
      </div>
    </article>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    '.works-header',
    { opacity: 0, y: 40 },
    {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#works', start: 'top 75%' },
    }
  );

  gsap.fromTo(
    '.work-card',
    { opacity: 0, y: 40 },
    {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#works', start: 'top 65%' },
    }
  );
</script>
