---
// Works.astro — Featured projects with horizontal GSAP animation

const techIcons: Record<string, { svg: string; name: string }> = {
  java: {
    name: "Java",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M22 35 L28 83 L72 83 L78 35 Z" stroke="#F89820" stroke-width="5" fill="none" stroke-linejoin="round"/>
      <path d="M78 47 C96 47 96 67 78 67" stroke="#F89820" stroke-width="5" fill="none" stroke-linecap="round"/>
      <path d="M38 32 Q41 20 44 32" stroke="#F89820" stroke-width="4" fill="none" stroke-linecap="round"/>
      <path d="M54 32 Q57 20 60 32" stroke="#F89820" stroke-width="4" fill="none" stroke-linecap="round"/>
    </svg>`,
  },
  spring: {
    name: "Spring Boot",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M78 12 C40 8 12 36 12 74 C12 82 14 88 14 88 C14 88 20 82 28 78 C22 68 22 54 32 42 C25 60 30 72 40 78 C55 85 75 78 84 60 C90 48 88 28 78 12 Z"
        stroke="#6DB33F" stroke-width="5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
      <path d="M20 86 C35 60 55 45 82 22" stroke="#6DB33F" stroke-width="4" fill="none" stroke-linecap="round"/>
    </svg>`,
  },
  mysql: {
    name: "MySQL",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="50" cy="23" rx="32" ry="13" stroke="#4479A1" stroke-width="5" fill="none"/>
      <line x1="18" y1="23" x2="18" y2="77" stroke="#4479A1" stroke-width="5"/>
      <line x1="82" y1="23" x2="82" y2="77" stroke="#4479A1" stroke-width="5"/>
      <ellipse cx="50" cy="77" rx="32" ry="13" stroke="#4479A1" stroke-width="5" fill="none"/>
      <ellipse cx="50" cy="50" rx="32" ry="13" stroke="#4479A1" stroke-width="5" fill="none"/>
    </svg>`,
  },
  jwt: {
    name: "JWT / Spring Security",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="24" y="46" width="52" height="42" rx="6" stroke="#8B5CF6" stroke-width="5" fill="none"/>
      <path d="M34 46 V32 a16 16 0 0 1 32 0 V46" stroke="#8B5CF6" stroke-width="5" fill="none" stroke-linecap="round"/>
      <circle cx="50" cy="65" r="5" fill="#8B5CF6"/>
      <line x1="50" y1="70" x2="50" y2="78" stroke="#8B5CF6" stroke-width="5" stroke-linecap="round"/>
    </svg>`,
  },
  docker: {
    name: "Docker",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="45" width="17" height="14" rx="2" stroke="#2496ED" stroke-width="4" fill="none"/>
      <rect x="29" y="45" width="17" height="14" rx="2" stroke="#2496ED" stroke-width="4" fill="none"/>
      <rect x="50" y="45" width="17" height="14" rx="2" stroke="#2496ED" stroke-width="4" fill="none"/>
      <rect x="29" y="28" width="17" height="14" rx="2" stroke="#2496ED" stroke-width="4" fill="none"/>
      <rect x="50" y="28" width="17" height="14" rx="2" stroke="#2496ED" stroke-width="4" fill="none"/>
      <path d="M8 63 C8 78 28 85 52 80 C67 76 78 65 82 55 C86 55 91 51 89 44"
        stroke="#2496ED" stroke-width="4" fill="none" stroke-linecap="round"/>
      <circle cx="87" cy="42" r="3" fill="#2496ED"/>
    </svg>`,
  },
  react: {
    name: "React",
    svg: `<svg width="26" height="26" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="50" cy="50" rx="46" ry="17" stroke="#61DAFB" stroke-width="5"/>
      <ellipse cx="50" cy="50" rx="46" ry="17" stroke="#61DAFB" stroke-width="5" transform="rotate(60 50 50)"/>
      <ellipse cx="50" cy="50" rx="46" ry="17" stroke="#61DAFB" stroke-width="5" transform="rotate(120 50 50)"/>
